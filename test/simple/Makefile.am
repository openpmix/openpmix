AM_CPPFLAGS = -I$(top_builddir)/src -I$(top_builddir)/src/include -I$(top_builddir)/include -I$(top_builddir)/include/pmix
# we do NOT want picky compilers down here

headers = simptest.h

noinst_PROGRAMS = simptest simpclient simppub simpdyn simpft simpdmodex \
                  test_pmix simptool simpdie simptimeout \
                  gwtest gwclient stability quietclient simpjctrl simpio simpsched \
                  simpcoord simpcycle simptoolcycle tool_server_switch doubleget simpfabric get_put_example simpvni \
                  hybrid simpqual simpdist legacy refresh simpgrpmember simpgrpdie simpgrpleader \
                  simpgrpcabort simpgrpctimeout simpgrpddie simpmonitor

#########################
# Wrapper scripts for running these programs out of the build tree.
#
# Unlike the "make check" tests, the programs here are launched by hand,
# so nothing sets up the MCA component search path for them. Any
# component built as a run-time-loadable plugin -- all of them under
# --enable-mca-dso, and pcompress/pnet-sshot even in a default build --
# sits in the build tree rather than on the library's default search
# path, so a program run straight from a tree that has never been
# installed fails PMIx_Init with "unable to find any usable plugins".
#
# Each generated run_FOO.sh sources test/pmix_test_env.sh to supply that
# path and then execs FOO with whatever arguments it was given, so
# "./run_simptest.sh -n 4" behaves like "./simptest -n 4" without
# requiring a prior "make install". Programs that fork children (e.g.
# simptest starting simpclient) pass the setting down through the
# environment. The wrapper also chdir's here first, because those
# programs look for their client alongside themselves as "./simpclient",
# so they only work when run from this directory -- the run_*.pl drivers
# under test/unit do the same. The programs themselves are libtool
# wrappers, so these scripts cannot simply reuse their names.

SIMPLE_WRAPPERS = \
	run_doubleget.sh \
	run_get_put_example.sh \
	run_gwclient.sh \
	run_gwtest.sh \
	run_hybrid.sh \
	run_legacy.sh \
	run_quietclient.sh \
	run_refresh.sh \
	run_simpclient.sh \
	run_simpcoord.sh \
	run_simpcycle.sh \
	run_simpdie.sh \
	run_simpdist.sh \
	run_simpdmodex.sh \
	run_simpdyn.sh \
	run_simpfabric.sh \
	run_simpft.sh \
	run_simpgrpcabort.sh \
	run_simpgrpctimeout.sh \
	run_simpgrpddie.sh \
	run_simpgrpdie.sh \
	run_simpgrpleader.sh \
	run_simpgrpmember.sh \
	run_simpio.sh \
	run_simpjctrl.sh \
	run_simpmonitor.sh \
	run_simppub.sh \
	run_simpqual.sh \
	run_simpsched.sh \
	run_simptest.sh \
	run_simptimeout.sh \
	run_simptool.sh \
	run_simptoolcycle.sh \
	run_simpvni.sh \
	run_stability.sh \
	run_test_pmix.sh \
	run_tool_server_switch.sh

noinst_SCRIPTS = $(SIMPLE_WRAPPERS)
CLEANFILES = $(SIMPLE_WRAPPERS)

$(SIMPLE_WRAPPERS): Makefile
	$(AM_V_GEN)pmix_prog=`echo "$@" | sed -e 's/^run_//' -e 's/\.sh$$//'`; \
	rm -f $@; \
	{ \
	  echo '#!/bin/sh'; \
	  echo '# Generated by test/simple/Makefile -- do not edit.'; \
	  echo ". $(abs_top_builddir)/test/pmix_test_env.sh"; \
	  echo "cd $(abs_builddir) || exit 1"; \
	  echo "exec ./$$pmix_prog" '"$$@"'; \
	} > $@; \
	chmod +x $@

#########################

